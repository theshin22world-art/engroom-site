{
  "redirects": [
    {
      "source": "/privacy.html",
      "destination": "/engroom/privacy.html",
      "permanent": false
    },
    {
      "source": "/terms.html",
      "destination": "/engroom/terms.html",
      "permanent": false
    },
    {
      "source": "/delete-account.html",
      "destination": "/engroom/delete-account.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/ocanspic",
      "destination": "https://ocanspic-site.vercel.app/"
    },
    {
      "source": "/ocanspic/:path*",
      "destination": "https://ocanspic-site.vercel.app/:path*"
    }
  ]
}
